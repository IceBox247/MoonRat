# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (miniapp + admin dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Database ----
# Dev SQLite. For Postgres: postgresql://user:pass@host:5432/moonrat  (and change provider in schema.prisma)
DATABASE_URL=file:./dev.db

# ---- Auth ----
JWT_SECRET=change-me-in-production
# Telegram Bot token — used to validate initData signatures. Leave blank to allow DEV mock auth.
TELEGRAM_BOT_TOKEN=
# When true (and no bot token), /api/auth/telegram accepts unsigned dev payloads. NEVER enable in prod.
ALLOW_DEV_AUTH=true

# ---- Admin bootstrap ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=moonrat-admin
ADMIN_JWT_SECRET=change-me-admin

# ---- TON ----
# mock | tonapi
TON_BALANCE_PROVIDER=mock
# Jetton master (contract) address of $MOONRAT. Required when provider=tonapi.
MOONRAT_JETTON_MASTER=
MOONRAT_JETTON_DECIMALS=9
# TonAPI base (https://tonapi.io) or toncenter; used when provider=tonapi
TONAPI_BASE=https://tonapi.io
TONAPI_KEY=

# ---- Purchase / swap ----
# Deep link users are sent to to buy/hold more $MOONRAT (STON.fi / DeDust / etc.)
MOONRAT_BUY_URL=https://app.ston.fi/swap
