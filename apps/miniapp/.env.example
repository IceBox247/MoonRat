# ---------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser
# ---------------------------------------------------------------------------
# Leave VITE_API_BASE empty: the API is same-origin (/api) in this single project.
VITE_API_BASE=
VITE_API_TARGET=http://localhost:4000
VITE_TONCONNECT_MANIFEST=/tonconnect-manifest.json
# Set to 1 for an offline UI preview with sample data (no backend/db needed).
VITE_DEMO=

# ---------------------------------------------------------------------------
# Backend (serverless /api function) — server-side only, NOT exposed to browser
# On Vercel these are set in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------
# Neon Postgres in prod; file:./dev.db for local dev.
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=moonrat-admin
ADMIN_JWT_SECRET=change-me-admin
# Leave blank + ALLOW_DEV_AUTH=true to test in a normal browser (no Telegram needed).
TELEGRAM_BOT_TOKEN=
ALLOW_DEV_AUTH=true
# mock | tonapi  (mock until the real $MOONRAT jetton address is set)
TON_BALANCE_PROVIDER=mock
MOONRAT_JETTON_MASTER=
MOONRAT_JETTON_DECIMALS=9
TONAPI_BASE=https://tonapi.io
TONAPI_KEY=
MOONRAT_BUY_URL=https://app.ston.fi/swap
CORS_ORIGINS=*
