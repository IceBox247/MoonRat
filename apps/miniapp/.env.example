# Where the frontend reaches the API. In dev, Vite proxies /api to this.
VITE_API_TARGET=http://localhost:4000
# Public base for the API when NOT using the dev proxy (e.g. production). Leave blank to use same-origin /api.
VITE_API_BASE=
# TON Connect manifest URL (must be publicly reachable in production)
VITE_TONCONNECT_MANIFEST=/tonconnect-manifest.json
# Set to 1 to run the app in DEMO mode (sample data, no backend needed).
# Use this for a static UI-preview deploy. Leave unset/0 for the real app.
VITE_DEMO=
