{
  "name": "@moonrat/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch api/_server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:pg": "node scripts/pg-schema.mjs",
    "db:setup": "prisma generate && prisma db push && tsx api/_server/seed.ts",
    "seed": "tsx api/_server/seed.ts",
    "vercel-build": "node scripts/pg-schema.mjs && prisma generate --schema prisma/schema.pg.prisma && prisma db push --schema prisma/schema.pg.prisma --skip-generate --accept-data-loss && tsx api/_server/seed.ts && vite build"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tonconnect/ui-react": "^2.0.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^11.11.17",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
